          }
        }
      }
    },
    "Allow the camera so you can point it at a plant to identify it. You can also pick a photo instead." : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អនុញ្ញាតឱ្យប្រើកាមេរ៉ា ដើម្បីឱ្យអ្នកអាចចង្អុលវាទៅកាន់រុក្ខជាតិមួយ ហើយសម្គាល់ប្រភេទរបស់វាបាន។ អ្នកក៏អាចជ្រើសរើសរូបថតជំនួសវិញបានដែរ។"
          }
