    "Also possible: %@" : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អាចជា៖ %@"
          }
        }
      }
    },
    "An admin hid this review, so it isn't shown to others or counted in the rating." : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកគ្រប់គ្រងបានលាក់ការវាយតម្លៃនេះ ដូច្នេះវាមិនត្រូវបានបង្ហាញដល់អ្នកដទៃ ឬរាប់បញ្ចូលក្នុងការវាយតម្លៃឡើយ។"
          }
        }
      }
    },
    "Answers to the questions we get most, and a way to reach us if yours isn't here." : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចម្លើយចំពោះសំណួរដែលយើងទទួលបានញឹកញាប់បំផុត និងវិធីទាក់ទងមកយើង ប្រសិនបើមិនមានសំណួររបស់អ្នកនៅទីនេះ។"
          }
        }
      }
    },
    "Anyone signed in can rate and review a plant, and you can edit or delete your own review at any time from the plant's page." : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកដែលបានចូលប្រើប្រាស់អាចវាយតម្លៃ និងសរសេរមតិយោបល់លើរុក្ខជាតិបាន ហើយអ្នកអាចកែសម្រួល ឬលុបមតិយោបល់របស់អ្នកនៅពេលណាក៏បានពីទំព័ររបស់រុក្ខជាតិនោះ។"
          }
        }
      }
    },
    "Anything from low light to full sun" : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចាប់ពីកន្លែងដែលមានពន្លឺតិច រហូតដល់កន្លែងដែលមានពន្លឺថ្ងៃពេញលេញ"
