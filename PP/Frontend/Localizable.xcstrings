          "stringUnit" : {
            "state" : "translated",
            "value" : "ប្រទាលកន្ទុយក្រពើ"
          }
        }
      }
    },
    "Already have an account?" : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មានគណនីរួចហើយ?"
